generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Hotel {
  id                String             @id @default(uuid())
  name              String
  timezone          String
  currency          String
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  address           String?
  checkInTime       String?            @map("check_in_time")
  checkOutTime      String?            @map("check_out_time")
  email             String?
  phone             String?
  auditLogs         AuditLog[]
  guests            Guest[]
  housekeepingTasks HousekeepingTask[]
  reservations      Reservation[]
  users             User[]
  notifications     Notification[]

  @@map("hotels")
}

model User {
  id                  String             @id @default(uuid())
  hotelId             String             @map("hotel_id")
  fullName            String             @map("full_name")
  email               String             @unique
  passwordHash        String             @map("password_hash")
  role                Role
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  auditLogs           AuditLog[]
  housekeepingTasks   HousekeepingTask[] @relation("AssignedTo")
  createdReservations Reservation[]      @relation("CreatedBy")
  sessions            Session[]
  hotel               Hotel              @relation(fields: [hotelId], references: [id])
  notifications       Notification[]

  @@index([hotelId], map: "users_hotel_id_fkey")
  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model Room {
  id                String             @id @default(uuid())
  hotelId           String             @map("hotel_id")
  roomNumber        String             @map("room_number")
  roomType          String             @map("room_type")
  basePrice         Decimal            @map("base_price") @db.Decimal(10, 2)
  status            RoomStatus         @default(AVAILABLE)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  floor             Int                @default(1)
  capacity          Int                @default(1)
  housekeepingTasks HousekeepingTask[]
  reservations      Reservation[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model Guest {
  id             String        @id @default(uuid())
  hotelId        String        @map("hotel_id")
  fullName       String        @map("full_name")
  phone          String?
  email          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  note           String?
  passportNumber String?       @map("passport_number")
  hotel          Hotel         @relation(fields: [hotelId], references: [id])
  reservations   Reservation[]

  @@index([hotelId], map: "guests_hotel_id_fkey")
  @@map("guests")
}

model Reservation {
  id              String            @id @default(uuid())
  hotelId         String            @map("hotel_id")
  roomId          String            @map("room_id")
  guestId         String            @map("guest_id")
  createdByUserId String            @map("created_by_user_id")
  checkInDate     DateTime          @map("check_in_date") @db.Date
  checkOutDate    DateTime          @map("check_out_date") @db.Date
  status          ReservationStatus @default(BOOKED)
  pricePerNight   Decimal           @map("price_per_night") @db.Decimal(10, 2)
  totalPrice      Decimal           @map("total_price") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus     @default(UNPAID) @map("payment_status")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  createdBy User  @relation("CreatedBy", fields: [createdByUserId], references: [id])
  guest     Guest @relation(fields: [guestId], references: [id])
  hotel     Hotel @relation(fields: [hotelId], references: [id])
  room      Room  @relation(fields: [roomId], references: [id])

  @@index([roomId, checkInDate, checkOutDate])
  @@index([createdByUserId], map: "reservations_created_by_user_id_fkey")
  @@index([guestId], map: "reservations_guest_id_fkey")
  @@index([hotelId], map: "reservations_hotel_id_fkey")
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@map("reservations")
}

model HousekeepingTask {
  id               String   @id @default(uuid())
  hotelId          String   @map("hotel_id")
  roomId           String   @map("room_id")
  assignedToUserId String   @map("assigned_to_user_id")
  status           TaskStatus @default(PENDING)
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  assignedTo User                    @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  hotel      Hotel                   @relation(fields: [hotelId], references: [id])
  room       Room                    @relation(fields: [roomId], references: [id])

  // Keep the existing photo data
  photos     Json?

  // New photos stored directly in the database
  photoFiles HousekeepingTaskPhoto[]

  @@index([hotelId, createdAt])
  @@index([hotelId, assignedToUserId, createdAt])
  @@index([hotelId, status])
  @@index([assignedToUserId], map: "housekeeping_tasks_assigned_to_user_id_fkey")
  @@index([roomId], map: "housekeeping_tasks_room_id_fkey")
  @@map("housekeeping_tasks")
}

model HousekeepingTaskPhoto {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now()) @map("created_at")

  task HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("housekeeping_task_photos")
}

model AuditLog {
  id           String   @id @default(uuid())
  hotelId      String   @map("hotel_id")
  userId       String?  @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@index([hotelId], map: "audit_logs_hotel_id_fkey")
  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}

model Notification {
  id      String @id @default(uuid()) @db.Char(36)
  hotelId String @map("hotel_id") @db.Char(36)
  userId  String @map("user_id") @db.Char(36)

  title   String           @db.VarChar(150)
  message String           @db.Text
  type    NotificationType

  taskId String? @map("task_id") @db.Char(36)

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([taskId])
  @@index([hotelId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_APPROVED
  TASK_REJECTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  IN_REVIEW
  NEEDS_CLEANING
  CLEANING
  OUT_OF_SERVICE
}

enum ReservationStatus {
  BOOKED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

