generator client {
  provider = "prisma-client"
  output = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Hotel {
  id                String             @id @default(uuid())
  name              String
  timezone          String
  currency          String
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  auditLogs         AuditLog[]
  guests            Guest[]
  housekeepingTasks HousekeepingTask[]
  reservations      Reservation[]
  rooms             Room[]
  users             User[]

  @@map("hotels")
}

model User {
  id String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel Hotel @relation(fields: [hotelId], references: [id])
  fullName String @map("full_name")
  email String @unique
  passwordHash String @map("password_hash")
  role Role
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  createdReservations Reservation[] @relation("CreatedBy")
  auditLogs AuditLog[]
  housekeepingTasks HousekeepingTask[] @relation("AssignedTo")

  @@index([hotelId], map: "users_hotel_id_fkey")
  @@map("users")
}

model Session {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  refreshTokenHash String @map("refresh_token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model Room {
  id String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel Hotel @relation(fields: [hotelId], references: [id])
  roomNumber String @map("room_number")
  roomType String @map("room_type")
  basePrice Decimal @map("base_price") @db.Decimal(10, 2)
  status RoomStatus @default(AVAILABLE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservations Reservation[]
  housekeepingTasks HousekeepingTask[]
  reservations      Reservation[]
  hotel             Hotel              @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model Guest {
  id String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel Hotel @relation(fields: [hotelId], references: [id])
  fullName String @map("full_name")
  phone String?
  email String?
  passportNumber  String?  @map("passport_number")
  note            String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@index([hotelId], map: "guests_hotel_id_fkey")
  @@map("guests")
}

model Reservation {
  id String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel Hotel @relation(fields: [hotelId], references: [id])
  roomId String @map("room_id")
  room Room @relation(fields: [roomId], references: [id])
  guestId String @map("guest_id")
  guest Guest @relation(fields: [guestId], references: [id])
  createdByUserId String @map("created_by_user_id")
  createdBy User @relation("CreatedBy", fields: [createdByUserId], references: [id])
  checkInDate DateTime @map("check_in_date") @db.Date
  checkOutDate DateTime @map("check_out_date") @db.Date
  status ReservationStatus @default(BOOKED)
  pricePerNight Decimal @map("price_per_night") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roomId, checkInDate, checkOutDate])
  @@index([createdByUserId], map: "reservations_created_by_user_id_fkey")
  @@index([guestId], map: "reservations_guest_id_fkey")
  @@index([hotelId], map: "reservations_hotel_id_fkey")
  @@map("reservations")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model HousekeepingTask {
  id String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel Hotel @relation(fields: [hotelId], references: [id])
  roomId String @map("room_id")
  room Room @relation(fields: [roomId], references: [id])
  assignedToUserId String @map("assigned_to_user_id")
  assignedTo User @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  status TaskStatus @default(PENDING)
  startedAt DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  notes String?
  photos Json? @map("photos")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([hotelId, createdAt])
  @@index([hotelId, assignedToUserId, createdAt])
  @@index([hotelId, status])
  @@map("housekeeping_tasks")
}

model AuditLog {
  id String @id @default(uuid())
  hotelId String @map("hotel_id")
  hotel Hotel @relation(fields: [hotelId], references: [id])
  userId String? @map("user_id")
  user User? @relation(fields: [userId], references: [id])
  action String
  entityType String @map("entity_type")
  metadataJson Json? @map("metadata_json")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([hotelId], map: "audit_logs_hotel_id_fkey")
  @@index([userId], map: "audit_logs_user_id_fkey")
  @@map("audit_logs")
}
